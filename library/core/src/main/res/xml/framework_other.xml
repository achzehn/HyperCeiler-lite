<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:myLocation="@string/system_framework_other_title"
    app:quick_restart="system">
    <PreferenceCategory android:title="@string/system_framework_screen_title">


        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_settings_anti_ques"
            android:summary="@string/system_settings_anti_ques_desc"
            android:title="@string/system_settings_anti_ques" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_framework_disable_72h_verify"
            android:title="@string/system_framework_disable_72h_verify" />





        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_other_flag_secure"
            android:summary="@string/system_other_flag_secure_desc"
            android:title="@string/system_other_flag_secure" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_framework_disable_keep_screen_on"
            android:summary="@string/system_framework_disable_keep_screen_on_desc"
            android:title="@string/system_framework_disable_keep_screen_on" />







        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_other_delete_on_post_notification"
            android:summary="@string/system_other_delete_on_post_notification_desc"
            android:title="@string/system_other_delete_on_post_notification" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="prefs_key_system_framework_allow_disable_protected_package"
            android:title="@string/system_framework_allow_disable_protected_package" />

    </PreferenceCategory>
</PreferenceScreen>